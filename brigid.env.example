# Generate once and keep this file readable only by the container host:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BRIGID_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Default is true. Set false to run Brigid as a shared, local-only default
# dashboard without Pocket ID accounts or server-side profile persistence.
BRIGID_OIDC_ENABLED=true
BRIGID_OIDC_ISSUER=https://auth.dryad.nexus
BRIGID_OIDC_CLIENT_ID=replace-with-pocket-id-client-uuid
BRIGID_OIDC_CLIENT_SECRET=replace-with-pocket-id-client-secret
BRIGID_PUBLIC_URL=https://brigid.dryad.nexus
BRIGID_ALLOWED_GROUPS=household
BRIGID_ADMIN_GROUPS=admin
BRIGID_SESSION_MAX_AGE_HOURS=168
BRIGID_COOKIE_SECURE=true

# The safe, user-visible household starter layout. Existing user profiles are
# never overwritten when this file changes.
BRIGID_DEFAULT_LAYOUT_FILE=/config/default-layout.json

# Optional Komodo integration. Use a dedicated API key with Read-only access
# to the named server; it is consumed only by the Brigid backend.
KOMODO_URL=https://komodo.dryad.nexus
KOMODO_SERVER=local
KOMODO_API_KEY=replace-with-read-only-komodo-key
KOMODO_API_SECRET=replace-with-read-only-komodo-secret

# Optional NVIDIA DCGM Exporter Prometheus endpoint. Keep this private to the
# homelab/Tailnet; Brigid parses it server-side and never exposes it directly.
GPU_METRICS_URL=http://dcgm-exporter:9400/metrics

# Caddy is only Brigid's reverse proxy. It must not apply forward-auth or
# inject identity headers: Brigid redirects to Pocket ID and owns the session.
