# Generate once and keep this file readable only by the container host:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BRIGID_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Default is true. Set false to run Brigid as a shared, local-only default
# dashboard without Pocket ID accounts or server-side profile persistence.
BRIGID_OIDC_ENABLED=true

# Optional Komodo integration. Use a dedicated API key with Read-only access
# to the named server; it is consumed only by the Brigid backend.
KOMODO_URL=https://komodo.dryad.nexus
KOMODO_SERVER=local
KOMODO_API_KEY=replace-with-read-only-komodo-key
KOMODO_API_SECRET=replace-with-read-only-komodo-secret

# Caddy's Pocket ID middleware injects these headers after authenticating.
# Use a stable subject header if your Caddy configuration is set up to inject one.
BRIGID_IDENTITY_HEADER=X-Auth-Email
BRIGID_NAME_HEADER=X-Auth-Name
